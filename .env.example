# FLO-ML environment contract (product plan §6.3)
# Copy to .env and leave ENV_NAME=local for the inner loop.
# Cloud jobs require an explicit ENV_NAME other than local.

ENV_NAME=local

# Floci (local AWS). Unset AWS_ENDPOINT_URL for real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# MLflow. Local UI is :5000. In AWS this becomes the SageMaker MLflow App ARN.
MLFLOW_TRACKING_URI=http://localhost:5000

# Artifact / data layout
S3_DATA_URI=s3://datasets/churn/train/
S3_VALID_URI=s3://datasets/churn/valid/
S3_MODEL_URI=s3://models/churn/
MLFLOW_ARTIFACT_BUCKET=s3://mlflow-artifacts

# Compute. local | local_gpu | process | ml.m5.xlarge | ml.g5.xlarge | ...
SAGEMAKER_INSTANCE=local
PROJECT=churn
EXPERIMENT=churn
MODEL_NAME=churn

# Training image used by local Docker mode and (later) SageMaker
TRAIN_IMAGE=flo-ml/sklearn-train:local
